<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/municipality_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/page_padding">

    <TextView
        android:id="@+id/municipality_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:textSize="26sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/municipality_image"
        android:layout_width="match_parent"
        android:layout_height="@dimen/municipality_image_height"
        android:layout_marginTop="12dp"
        android:contentDescription="@string/municipality_photo"
        android:scaleType="fitCenter" />

    <ScrollView
        android:id="@+id/information_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:fillViewport="true">
        <TextView
            android:id="@+id/municipality_information"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="5dp"
            android:padding="12dp"
            android:textSize="18sp" />
    </ScrollView>

    <Button
        android:id="@+id/visit_site"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:layout_marginTop="12dp"
        android:text="@string/visit_site"
        android:textAllCaps="false"
        android:textSize="18sp" />
</LinearLayout>
